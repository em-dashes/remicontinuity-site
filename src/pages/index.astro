<script>
  const io = new IntersectionObserver((es) => {
    es.forEach(e => { if (e.isIntersecting) e.target.classList.add('posted'); });
  }, { threshold: 0.3 });
  document.querySelectorAll('tr.entry').forEach((el, i) => {
    el.style.animationDelay = `${i * 90}ms`; io.observe(el);
  });
  document.querySelectorAll('.note').forEach(el => io.observe(el));
